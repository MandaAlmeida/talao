generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORGANIZADOR
  CLIENTE
  PORTARIA
}

enum EventStatus {
  RASCUNHO
  EM_BREVE
  PRE_VENDA
  PUBLICADO
}

enum TicketAudience {
  GERAL
  RESTRITO
}

enum BookingStatus {
  PENDENTE
  CONFIRMADO
  CANCELADO
  EXPIRADO
  USADO
}

enum OrderStatus {
  PENDENTE
  CONFIRMADO
  CANCELADO
  EXPIRADO
}

model User {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  papel     Role
  createdAt DateTime @default(now())

  eventos   Event[]
  bookings  Booking[]
  orders    Order[]
}

model Event {
  id                String      @id @default(uuid())
  titulo            String
  categoria         String
  assunto           String?
  descricaoCompleta String?
  status            EventStatus @default(RASCUNHO)
  modalidade        String
  cidade            String
  endereco          Json?
  linkAcesso        String?
  dataInicio        DateTime
  dataFim           DateTime
  gradiente         String
  tmdbId            Int?
  posterUrl         String?
  usaMapaAssentos   Boolean     @default(false)
  organizadorId     String
  organizador       User        @relation(fields: [organizadorId], references: [id])
  createdAt         DateTime    @default(now())

  sessoes           Sessao[]
  bookings          Booking[]
  orders            Order[]
}

// Uma exibição/apresentação concreta do evento (ex: sessão de terça às 19h,
// sala 3). Eventos com uma única sessão continuam funcionando normalmente —
// "sessões diárias" é só um evento com várias Sessao.
model Sessao {
  id        String   @id @default(uuid())
  eventoId  String
  evento    Event    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  dataHora  DateTime
  sala      String?
  createdAt DateTime @default(now())

  ticketTypes TicketType[]
  bookings    Booking[]
  orders      Order[]
  seats       Seat[]
}

model TicketType {
  id            String         @id @default(uuid())
  sessaoId      String
  sessao        Sessao         @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  nome          String
  gratuito      Boolean        @default(false)
  preco         Decimal        @default(0)
  capacidade    Int
  vendaInicio   DateTime?
  vendaFim      DateTime?
  publico       TicketAudience @default(GERAL)
  descricao     String?
  fileiraInicio String?
  fileiraFim    String?

  bookings      Booking[]
}

model Seat {
  id        String  @id @default(uuid())
  sessaoId  String
  sessao    Sessao  @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  codigo    String
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  @@unique([sessaoId, codigo])
}

model Order {
  id                    String      @id @default(uuid())
  clienteId             String
  cliente               User        @relation(fields: [clienteId], references: [id])
  eventoId              String
  evento                Event       @relation(fields: [eventoId], references: [id])
  sessaoId              String
  sessao                Sessao      @relation(fields: [sessaoId], references: [id])
  status                OrderStatus @default(PENDENTE)
  valorTotalCentavos    Int
  stripePaymentIntentId String?     @unique
  createdAt             DateTime    @default(now())

  bookings              Booking[]
}

model Booking {
  id           String        @id @default(uuid())
  eventoId     String
  evento       Event         @relation(fields: [eventoId], references: [id])
  sessaoId     String
  sessao       Sessao        @relation(fields: [sessaoId], references: [id])
  ticketTypeId String
  ticketType   TicketType    @relation(fields: [ticketTypeId], references: [id])
  clienteId    String
  cliente      User          @relation(fields: [clienteId], references: [id])
  quantidade   Int
  valorCentavos Int          @default(0)
  status       BookingStatus @default(PENDENTE)
  codigoCompra String        @unique
  qrAssinatura String
  shareToken   String        @unique @default(uuid())
  stripePaymentIntentId String? @unique
  orderId      String?
  order        Order?        @relation(fields: [orderId], references: [id])
  expiraEm     DateTime?
  createdAt    DateTime      @default(now())
  usadoEm      DateTime?

  seats        Seat[]
}
